opam-version: "2.0"
synopsis: "Browser-based Mario platformer in OCaml"
description:
  "MariOCaml is an HTML5 canvas implementation of Super Mario Bros mechanics, compiled to JavaScript with js_of_ocaml."
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.17"}
  "js_of_ocaml" {>= "4.1"}
  "js_of_ocaml-compiler" {>= "4.1"}
  "js_of_ocaml-ppx" {>= "4.1"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
